<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="lineage"
          fetch="https://github.com/LineageOS"
          revision="lineage-22.2" />

  <!-- External -->
  <project path="external/json-c" name="android_external_json-c" remote="lineage" />
  <project path="external/chromium-webview" name="platform/external/chromium-webview" groups="pdk" clone-depth="1" remote="aosp" />

  <!-- HALs -->
  <project path="hardware/lineage/interfaces" name="android_hardware_lineage_interfaces" remote="lineage" />

  <!-- Packages -->
  <project path="packages/apps/Aperture" name="android_packages_apps_Aperture" remote="lineage" />
  <project path="packages/apps/AudioFX" name="android_packages_apps_AudioFX" remote="lineage" />
  <project path="packages/resources/devicesettings" name="android_packages_resources_devicesettings" remote="lineage" />
  <project path="packages/apps/Contacts" name="android_packages_apps_Contacts" remote="lineage" />
  <project path="packages/apps/DeskClock" name="android_packages_apps_DeskClock" remote="lineage" />
  <project path="packages/apps/Dialer" name="android_packages_apps_Dialer" remote="lineage" />
  <project path="packages/apps/DocumentsUI" name="android_packages_apps_DocumentsUI" remote="lineage" />
  <project path="packages/apps/Etar" name="android_packages_apps_Etar" remote="lineage" />
  <project path="packages/apps/ExactCalculator" name="android_packages_apps_ExactCalculator" remote="lineage" />
  <project path="packages/apps/Glimpse" name="android_packages_apps_Glimpse" remote="lineage" />
  <project path="packages/apps/Jelly" name="android_packages_apps_Jelly" remote="lineage" />
  <project path="packages/apps/Messaging" name="android_packages_apps_Messaging" remote="lineage" />
  <project path="packages/apps/Recorder" name="android_packages_apps_Recorder" remote="lineage" />
  <project path="packages/apps/Twelve" name="android_packages_apps_Twelve" remote="lineage" />
    
  <!-- Prebuilts -->
  <project path="prebuilts/extract-tools" name="android_prebuilts_extract-tools" remote="lineage" clone-depth="1" />

  <!-- Tools Repos -->
  <project path="tools/extract-utils" name="android_tools_extract-utils" remote="lineage" />
  <project path="lineage/scripts" name="scripts" groups="tools" remote="lineage" revision="main" />

</manifest>
